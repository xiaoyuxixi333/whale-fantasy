{
  "name": "dsh-skin-whale-fantasy",
  "version": "1.0.0",
  "private": true,
  "description": "鲸鱼娘 · 未至之境 — 视频背景的深色 DSH Web 皮肤（本地安装版）",
  "type": "module",
